# Historical visual mockups; retained locally, excluded from Git.
/design-references/qvu/

# Local agent configuration and credentials.
/.agents/
/.codex/
/.aws/

# Meson output and validation interpreter caches.
/build*/
__pycache__/

# Generated raw validation runs; curated results remain tracked in docs/validation/.
/docs/validation/runs/

# Core dumps can hold page memory (F-77); never commit one.
core
*.core
core.[0-9]*

# libFuzzer output (D-46); a failing input is kept on purpose in tests/fuzz/seeds/.
crash-*
leak-*
timeout-*
oom-*
fuzz-*.log
